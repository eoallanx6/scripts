local function now()
    return os.clock()
end

local function safeCall(fn, ...)
    if type(fn) ~= "function" then
        return false, nil
    end
    return pcall(fn, ...)
end

local function getCharacter(player)
    player = player or LP
    return player and player.Character
end

local function getHumanoid(model)
    if not model then return nil end
    return model:FindFirstChildOfClass("Humanoid") or model:FindFirstChild("Humanoid")
end

local function readHealthObject(obj)
    if not obj then
        return nil
    end

    if obj:IsA("Humanoid") then
        return tonumber(obj.Health)
    end

    if obj:IsA("ValueBase") then
        return tonumber(obj.Value)
    end

    return nil
end

local function readModelHealth(model)
    if not model then
        return nil
    end

    local hum = getHumanoid(model)
    local value = readHealthObject(hum)

    if value ~= nil then
        return value
    end

    local health = model:FindFirstChild("Health")
    value = readHealthObject(health)

    if value ~= nil then
        return value
    end

    return nil
end

local function readModelMaxHealth(model)
    if not model then
        return nil
    end

    local hum = getHumanoid(model)
    if hum and hum:IsA("Humanoid") then
        return tonumber(hum.MaxHealth)
    end

    local maxHealth = model:FindFirstChild("MaxHealth")
    if maxHealth and maxHealth:IsA("ValueBase") then
        return tonumber(maxHealth.Value)
    end

    return nil
end

local function getRoot(model)
    if not model then return nil end
    if model:IsA("Player") then
        model = model.Character
    end
    return model and (
        model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("RootPart")
        or model:FindFirstChild("Engine")
        or model.PrimaryPart
    )
end

local function isAlive(model)
    if not model or not model.Parent then
        return false
    end

    local hp = readModelHealth(model)
    if hp ~= nil then
        return hp > 0
    end

    return getRoot(model) ~= nil
end

local function localAlive()
    local char = getCharacter()
    if not char then
        return false
    end

    local hp = readModelHealth(char)
    return hp ~= nil and hp > 0
end

local function distance(a, b)
    local function pos(v)
        if typeof(v) == "Vector3" then return v end
        if typeof(v) == "CFrame" then return v.Position end
        if typeof(v) == "Instance" then
            if v:IsA("BasePart") then return v.Position end
            local r = getRoot(v)
            return r and r.Position or nil
        end
        return nil
    end

    local pa, pb = pos(a), pos(b)
    if not pa or not pb then return math.huge end
    return (pa - pb).Magnitude
end

local function toCFrame(v)
    if typeof(v) == "CFrame" then return v end
    if typeof(v) == "Vector3" then return CFrame.new(v) end
    if typeof(v) == "Instance" then
        if v:IsA("BasePart") then return v.CFrame end
        local r = getRoot(v)
        return r and r.CFrame or nil
    end
    return nil
end

local function getRaceValue(player)
    player = player or LP
    local data = player and player:FindFirstChild("Data")
    local race = data and data:FindFirstChild("Race")
    return race and tostring(race.Value) or nil
end

local function normalizeRace(race)
    race = tostring(race or "")
    local aliases = {
        ["Angel"] = "Skypiea",
        ["Skypiea"] = "Skypiea",
        ["Shark"] = "Fishman",
        ["Fishman"] = "Fishman",
        ["Rabbit"] = "Mink",
        ["Mink"] = "Mink",
        ["Human"] = "Human",
        ["Ghoul"] = "Ghoul",
        ["Cyborg"] = "Cyborg",
    }
    return aliases[race] or race
end

local V3SkillByRace = {
    Human = "Last Resort",
    Mink = "Agility",
    Skypiea = "Heavenly Blood",
    Fishman = "Water Body",
    Ghoul = "Heightened Senses",
    Cyborg = "Energy Core",
}

local function playerHasTool(player, name)
    if not player or not name then return false end
    local bp = player:FindFirstChild("Backpack")
    local char = player.Character
    return (bp and bp:FindFirstChild(name) ~= nil)
        or (char and char:FindFirstChild(name) ~= nil)
end

local function readValueObject(obj)
    if not obj then return nil end

    -- Folder/Model nao possuem .Value.
    if obj:IsA("ValueBase") then
        return obj.Value
    end

    return nil
end

local function playerRaceTier(player)
    if not player then return 1 end

    local race = normalizeRace(getRaceValue(player))
    local data = player:FindFirstChild("Data")
    local raceObj = data and data:FindFirstChild("Race")

    -- 1) Dados explicitos de versao, quando existirem.
    if data then
        local explicit =
            data:FindFirstChild("RaceV")
            or data:FindFirstChild("RaceLevel")
            or data:FindFirstChild("V3")

        local value = readValueObject(explicit)

        if value == true then
            return 3
        end

        if type(value) == "number" then
            if value >= 4 then return 4 end
            if value >= 3 then return 3 end
            if value >= 2 then return 2 end
        end
    end

    -- 2) Skill da V3 e um indicador forte e nao depende de Evolved.Value.
    local v3Skill = V3SkillByRace[race]
    if v3Skill and playerHasTool(player, v3Skill) then
        return 3
    end

    -- 3) Evolved pode ser Folder no jogo atual.
    -- A existencia dela indica evolucao, mas NAO acessamos .Value.
    local evolved = raceObj and raceObj:FindFirstChild("Evolved")
    if evolved then
        local value = readValueObject(evolved)

        if type(value) == "number" then
            if value >= 4 then return 4 end
            if value >= 3 then return 3 end
            if value >= 2 then return 2 end
        end

        -- Se for Folder/Model, no minimo sabemos que houve evolucao.
        return 2
    end

    return 1
end

function Module:_status(main, sub)
    self.State.LastStatus = {
        Main = main,
        Sub = sub,
        Time = os.clock(),
    }

    local fn = self.Adapter.SetTask
    if type(fn) == "function" then
        pcall(fn, main, sub)
    else
        if main then print("[RaceV3] " .. tostring(main)) end
        if sub then print("[RaceV3] " .. tostring(sub)) end
    end
end

function Module:_shouldContinue()
    return self.State.Running and not self.State.StopRequested
end

function Module:Bind(adapter)
    if type(adapter) ~= "table" then
        return self
    end

    for k, v in pairs(adapter) do
        self.Adapter[k] = v
    end

    return self
end

function Module:AutoBindFromAllanHub()
    local env = getgenv and getgenv() or _G

    if not self.Adapter.SetTask and type(env.SetTask) == "function" then
        self.Adapter.SetTask = function(main, sub)
            if main then env.SetTask("MainTask", main) end
            if sub then env.SetTask("SubTask", sub) end
        end
    end

    if not self.Adapter.Hop and type(env.Hop) == "function" then
        self.Adapter.Hop = function(reason)
            return env.Hop(reason or "Race V3")
        end
    end

    if not self.Adapter.SSS and type(env.SSS) == "function" then
        self.Adapter.SSS = function(pos, condition)
            return env.SSS(pos, condition)
        end
    end

    if not self.Adapter.MoveTo and env.TweenController and type(env.TweenController.Create) == "function" then
        self.Adapter.MoveTo = function(cf)
            return env.TweenController.Create(cf)
        end
    end

    if not self.Adapter.AttackMob and env.CombatController and type(env.CombatController.Attack) == "function" then
        self.Adapter.AttackMob = function(target)
            local name = typeof(target) == "Instance" and target.Name or tostring(target)
            return env.CombatController.Attack(name)
        end
    end

    if not self.Adapter.EquipMelee
        and env.FunctionsHandler
        and env.FunctionsHandler.LocalPlayerController
        and env.FunctionsHandler.LocalPlayerController.Methods
        and env.FunctionsHandler.LocalPlayerController.Methods.EquipTool
    then
        self.Adapter.EquipMelee = function()
            return env.FunctionsHandler.LocalPlayerController.Methods.EquipTool:Call("Melee")
        end
    end

    return self
end

function Module:_defaultMoveTo(target, condition)
    local cf = toCFrame(target)
    local char = getCharacter()
    local hrp = getRoot(char)
    if not cf or not hrp then return false end

    local d = (hrp.Position - cf.Position).Magnitude
    if d <= 5 then
        return true
    end

    local speed = self.Config.DefaultTweenSpeed
    local tween = TweenService:Create(
        hrp,
        TweenInfo.new(math.max(d / speed, 0.05), Enum.EasingStyle.Linear),
        {CFrame = cf}
    )
    tween:Play()

    local started = now()
    while self:_shouldContinue() and localAlive() do
        if condition and not condition() then
            tween:Cancel()
            return false
        end
        if distance(hrp, cf) <= 7 then
            return true
        end
        if now() - started > math.max(d / speed + 4, 8) then
            break
        end
        task.wait(0.1)
    end

    return distance(hrp, cf) <= 12
end

function Module:_moveTo(target, condition)
    if type(self.Adapter.MoveTo) == "function" then
        local ok, result = pcall(self.Adapter.MoveTo, target, condition)
        if ok then return result ~= false end
    end
    return self:_defaultMoveTo(target, condition)
end

function Module:_sss(position, condition)
    if type(self.Adapter.SSS) == "function" then
        pcall(self.Adapter.SSS, position, condition)
        return true
    end
    return false
end

function Module:_hop(reason)
    if type(self.Adapter.Hop) ~= "function" then
        self:_status("Race V3 | Hop necessário", tostring(reason) .. " | adapter Hop não conectado")
        return false
    end

    self:_status("Race V3 | Server Hop", reason)
    pcall(self.Adapter.Hop, reason)
    return true
end

function Module:_equipMelee()
    if type(self.Adapter.EquipMelee) == "function" then
        pcall(self.Adapter.EquipMelee)
        return
    end

    local char = getCharacter()
    local hum = getHumanoid(char)
    local bp = LP:FindFirstChild("Backpack")
    if not hum or not bp then return end

    for _, tool in ipairs(bp:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.Name == "Combat") then
            hum:EquipTool(tool)
            return
        end
    end
end

function Module:_attackMob(target, condition)
    if not target then return false end

    if type(self.Adapter.AttackMob) == "function" then
        local ok, result = pcall(self.Adapter.AttackMob, target, condition)
        return ok and result ~= false
    end

    self:_equipMelee()
    local r = getRoot(target)
    if r then
        self:_moveTo(r.CFrame * CFrame.new(0, 20, 0), condition)
    end
    return false
end

function Module:_attackPlayer(player, condition)
    if not player or player == LP then return false end

    if type(self.Adapter.AttackPlayer) == "function" then
        local ok, result = pcall(self.Adapter.AttackPlayer, player, condition)
        return ok and result ~= false
    end

    -- Fallback: usa o mesmo controlador de mob se o principal aceitar Model.
    if type(self.Adapter.AttackMob) == "function" and player.Character then
        local ok, result = pcall(self.Adapter.AttackMob, player.Character, condition)
        return ok and result ~= false
    end

    self:_equipMelee()
    local root = getRoot(player.Character)
    if root then
        self:_moveTo(root.CFrame * CFrame.new(0, 8, 4), condition)
    end
    return false
end

function Module:_findWenlockNPC()
    local roots = {
        Workspace:FindFirstChild("NPCs"),
        Workspace:FindFirstChild("Map"),
        Workspace,
    }

    for _, root in ipairs(roots) do
        if root then
            for _, obj in ipairs(root:GetDescendants()) do
                local lname = string.lower(tostring(obj.Name or ""))
                local matched =
                    lname == "arowe"
                    or lname == "wenlocktoad"
                    or string.find(lname, "arowe", 1, true)
                    or string.find(lname, "wenlock", 1, true)

                if matched then
                    if obj:IsA("Model") then
                        local r = getRoot(obj)
                        if r then
                            return obj, r
                        end
                    elseif obj:IsA("BasePart") then
                        return obj.Parent, obj
                    end
                end
            end
        end
    end

    return nil, nil
end

function Module:_goToWenlock(label)
    label = tostring(label or "Arowe/Wenlocktoad")

    local started = now()
    local lastTween = 0
    local lastStream = 0
    local triedSSS = false
    local fixedCF = self.Config.WenlockFixedCFrame

    while self:_shouldContinue()
        and now() - started < self.Config.WenlockApproachTimeout
    do
        local npc, root = self:_findWenlockNPC()
        local myRoot = getRoot(getCharacter())

        if not myRoot then
            task.wait(0.1)
            continue
        end

        local targetCF = root
            and (root.CFrame * CFrame.new(0, 0, 4))
            or (fixedCF * CFrame.new(0, 0, 4))

        local targetPos = root
            and root.Position
            or fixedCF.Position

        local distance = (myRoot.Position - targetPos).Magnitude

        self:_status(
            "Race V3 Human | " .. label,
            (root and "Indo ate Arowe" or "Indo ao local fixo do Arowe")
                .. " | "
                .. tostring(math.floor(distance))
                .. " studs"
        )

        -- Agora TP Reset/SSS está LIBERADO para acelerar viagens longas.
        -- Tenta uma vez por ida; depois termina a aproximação por Tween.
        if not triedSSS
            and distance > 1200
            and type(self.Adapter.SSS) == "function"
        then
            triedSSS = true

            self:_status(
                "Race V3 Human | " .. label,
                "TP Reset para aproximar do Arowe"
            )

            pcall(
                self.Adapter.SSS,
                targetPos,
                function()
                    return self:_shouldContinue()
                end
            )

            task.wait(1)
            continue
        end

        if distance <= self.Config.WenlockReachDistance then
            self:_status(
                "Race V3 Human | " .. label,
                "Perto do NPC | pronto para interagir"
            )
            return true
        end

        if now() - lastTween >= 0.25 then
            lastTween = now()
            self:_moveTo(targetCF)
        end

        if now() - lastStream >= 0.75 then
            lastStream = now()

            if type(self.Adapter.RequestStream) == "function" then
                pcall(
                    self.Adapter.RequestStream,
                    targetPos,
                    2500
                )
            end
        end

        task.wait(0.1)
    end

    self:_status(
        "Race V3 Human | " .. label,
        "Nao conseguiu chegar no Arowe | remote NAO sera chamado"
    )

    return false
end

function Module:_invokeWenlock(action, requireNear)
    -- Usa sempre a referência ATUAL do RemoteFunction.
    -- Não depende do CommF capturado quando o loadstring carregou.
    local currentRemotes = ReplicatedStorage:FindFirstChild("Remotes")
    local currentCommF = currentRemotes and currentRemotes:FindFirstChild("CommF_")

    if not currentCommF then
        warn(
            "[Allan RaceV3] Wenlocktoad("
                .. tostring(action)
                .. ") => REMOTE_NAO_ENCONTRADO"
        )
        return nil
    end

    local ok, result = pcall(function()
        return currentCommF:InvokeServer("Wenlocktoad", tostring(action))
    end)

    if ok then
        warn(
            "[Allan RaceV3] Wenlocktoad("
                .. tostring(action)
                .. ") => "
                .. tostring(result)
        )

        if tostring(action) == "1" then
            self.State.LastWenlockState = result
        end

        return result
    end

    warn(
        "[Allan RaceV3] Wenlocktoad("
            .. tostring(action)
            .. ") FALHOU | erro="
            .. tostring(result)
    )

    return nil
end

function Module:WenlockState(requireNear)
    return self:_invokeWenlock("1", false)
end

function Module:IsV3()
    -- Fonte principal: o codigo principal ja possui IsRaceV3DoneStrict(),
    -- que conhece o cache/GuideModule/Wenlocktoad atual.
    if type(self.Adapter.IsV3) == "function" then
        local ok, result = pcall(self.Adapter.IsV3)
        if ok and result == true then
            return true
        end
    end

    local char = getCharacter()
    if char and char:FindFirstChild("RaceTransformed") then
        return true
    end

    local race = normalizeRace(getRaceValue(LP))
    local skill = V3SkillByRace[race]

    if skill and playerHasTool(LP, skill) then
        return true
    end

    -- Data.Race.Evolved pode ser Folder. NUNCA usa evolved.Value diretamente.
    local data = LP:FindFirstChild("Data")
    if data then
        local explicit =
            data:FindFirstChild("RaceV")
            or data:FindFirstChild("RaceLevel")
            or data:FindFirstChild("V3")

        local value = readValueObject(explicit)

        if value == true then
            return true
        end

        if type(value) == "number" and value >= 3 then
            return true
        end
    end

    -- IMPORTANTE:
    -- Nao usa Wenlocktoad("1") para checar V3.
    -- Na Human esse remote e reservado SOMENTE para iniciar a missao
    -- uma vez antes de Diamond -> Jeremy -> Orbitus.
    return false
end

function Module:TryDeliverV3()
    if self:IsV3() then
        return true
    end

    local state = self:WenlockState(false)

    if state == -2 then
        self:_status(
            "Race V3 | Concluida",
            "Wenlocktoad(1) = -2"
        )
        return true
    end

    if state == 2 then
        self:_status(
            "Race V3 | Entregando missao",
            "Servidor liberou entrega | Wenlocktoad(3)"
        )

        self:_invokeWenlock("3", false)
        task.wait(self.Config.WenlockDeliveryDelay)

        local after = self:WenlockState(false)

        if after == -2 or self:IsV3() then
            self:_status(
                "Race V3 | Concluida",
                "Wenlocktoad(1) = " .. tostring(after)
            )
            return true
        end
    end

    return false
end

function Module:ForceDeliverHumanV3(reason)
    local allKilled = self:_humanAllBossesKilledByModule()

    if not (self.State.HumanSequenceStarted and allKilled) then
        self:_status(
            "Race V3 Human | Entrega bloqueada",
            "Ainda nao confirmou as 3 kills locais"
        )
        return false
    end

    -- Nunca spamma a entrega.
    local nowClock = os.clock()
    local last = tonumber(self.State.HumanLastDeliveryAt or 0)

    if nowClock - last < 8 then
        self:_status(
            "Race V3 Human | Aguardando servidor",
            "Cooldown da entrega"
        )
        return false
    end

    self.State.HumanLastDeliveryAt = nowClock

    if self:IsV3() then
        self:_status(
            "Race V3 Human | V3 confirmada",
            "Deteccao do principal confirmou V3"
        )
        return true
    end

    self:_status(
        "Race V3 Human | 3 bosses abatidos",
        "Voltando ate Arowe/Wenlocktoad para entregar"
    )

    -- Depois das 3 kills, volta fisicamente ao NPC.
    -- Se não chegar, NÃO chama Wenlocktoad("3").
    if not self:_goToWenlock("Entregar quest") then
        return false
    end

    self:_status(
        "Race V3 Human | Entregando quest",
        tostring(reason or "Diamond + Jeremy + Orbitus")
    )

    task.wait(0.5)

    -- UMA tentativa por ciclo, somente ao lado do NPC.
    local result = self:_invokeWenlock("3", false)
    local resultText = string.lower(tostring(result or ""))

    warn(
        "[Allan RaceV3 Human] validacao servidor Wenlocktoad(3) => "
            .. tostring(result)
    )

    task.wait(0.8)

    if self:IsV3() then
        self.State.HumanDeliveryRejected = false

        self:_status(
            "Race V3 Human | V3 confirmada",
            "Servidor aceitou a ordem"
        )
        return true
    end

    -- O servidor informou explicitamente que a ordem nao foi concluida.
    -- Portanto nossas flags locais NAO sao verdade suficiente.
    local incompleteOrder =
        string.find(resultText, "haven't completed my order", 1, true) ~= nil
        or string.find(resultText, "havent completed my order", 1, true) ~= nil
        or string.find(resultText, "defeat jeremy", 1, true) ~= nil
        or (
            string.find(resultText, "jeremy", 1, true) ~= nil
            and string.find(resultText, "diamond", 1, true) ~= nil
            and string.find(resultText, "orbitus", 1, true) ~= nil
        )

    if incompleteOrder then
        self.State.HumanDeliveryRejected = true

        -- O servidor rejeitou a tentativa inteira. Começa NOVO ciclo,
        -- mas sem spam: Wenlocktoad("2") será chamado uma única vez
        -- no início da próxima tentativa.
        self.State.HumanKilled = {}
        self.State.HumanSequenceStarted = false
        self.State.HumanQuestStarted = false
        self.State.HumanRetryNoHopUntil =
            os.clock() + self.Config.HumanRetryNoHopSeconds

        self.State.HumanServerGraceUntil =
            math.max(
                tonumber(self.State.HumanServerGraceUntil or 0),
                os.clock() + self.Config.HumanRetryNoHopSeconds
            )

        self:_status(
            "Race V3 Human | Servidor rejeitou as kills",
            "Novo ciclo | sem Hop imediato"
        )

        warn(
            "[Allan RaceV3 Human] servidor rejeitou a tentativa; "
            .. "novo ciclo sera iniciado com UM Wenlocktoad(2)"
        )

        return false
    end

    -- Qualquer outro retorno: não fica tentando 8 vezes seguidas.
    self:_status(
        "Race V3 Human | Entrega pendente",
        "Servidor nao confirmou V3 | aguardando novo ciclo"
    )

    return false
end

function Module:_pollUntilDeliverable(timeoutSeconds, label)
    local started = now()
    while self:_shouldContinue() and now() - started < timeoutSeconds do
        local state = self:WenlockState(false)

        self:_status(
            "Race V3 | Aguardando servidor",
            (label or "Objetivo") .. " | Wenlocktoad=" .. tostring(state)
        )

        if state == 2 then
            return self:TryDeliverV3()
        end

        if self:IsV3() then
            return true
        end

        task.wait(self.Config.WenlockPollDelay)
    end

    return false
end

function Module:_enablePvPIfNeeded()
    local pg = LP:FindFirstChild("PlayerGui")
    local main = pg and pg:FindFirstChild("Main")
    local disabled = main and main:FindFirstChild("PvpDisabled", true)

    if disabled and disabled.Visible then
        self:_status("Race V3 | PvP", "Ativando PvP")
        pcall(function()
            CommF:InvokeServer("EnablePvp")
        end)
        task.wait(self.Config.EnablePvPWait)
    end
end

function Module:_isInSafeZone(character)
    if not character then return true end

    local origin = Workspace:FindFirstChild("_WorldOrigin")
    local zones = origin and origin:FindFirstChild("SafeZones")
    if not zones then return false end

    local root = getRoot(character)
    local hp = readModelHealth(character)
    local maxHp = readModelMaxHealth(character)

    if not root then
        return true
    end

    for _, zone in ipairs(zones:GetChildren()) do
        if zone:IsA("BasePart")
            and (zone.Position - root.Position).Magnitude <= 400
        then
            if hp and maxHp and maxHp > 0 then
                if hp >= maxHp * 0.80 then
                    return true
                end
            else
                return true
            end
        end
    end

    return false
end

function Module:_findHumanBoss(name)
    -- Usa primeiro o sistema NATIVO do principal, que conhece o formato
    -- atualizado de workspace.Enemies e faz match parcial.
    if type(self.Adapter.FindEnemy) == "function" then
        local ok, mob = pcall(self.Adapter.FindEnemy, name)
        if ok and mob and isAlive(mob) then
            return mob
        end
    end

    local enemies = Workspace:FindFirstChild("Enemies")
    if not enemies then
        return nil
    end

    local direct = enemies:FindFirstChild(name)
    if direct and direct:IsA("Model") and isAlive(direct) then
        return direct
    end

    local wanted = string.lower(tostring(name))
    for _, mob in ipairs(enemies:GetChildren()) do
        if mob:IsA("Model") and isAlive(mob) then
            local lname = string.lower(tostring(mob.Name or ""))
            if lname == wanted
                or string.find(lname, wanted, 1, true)
            then
                return mob
            end
        end
    end

    return nil
end

function Module:_getHumanBoss(name)
    -- 1) Já renderizado.
    local existing = self:_findHumanBoss(name)
    if existing then
        return existing, true
    end

    -- 2) Confirma se o spawn está realmente ativo no servidor.
    local spawnActive = false

    if type(self.Adapter.CheckBossSpawn) == "function" then
        local ok, result = pcall(self.Adapter.CheckBossSpawn, name)
        spawnActive = ok and result == true
    end

    if not spawnActive then
        return nil, false
    end

    -- IMPORTANTE:
    -- Se spawnActive == true, esse boss EXISTE neste servidor.
    -- Mesmo que o Model ainda não tenha streamado, NÃO pode dar Hop.
    self:_status(
        "Race V3 Human | " .. tostring(name) .. " ativo",
        "Tween ate o spawn | sem Hop enquanto Active"
    )

    if type(self.Adapter.GetMainEnemy) == "function" then
        local ok, mob = pcall(
            self.Adapter.GetMainEnemy,
            name,
            45
        )

        if ok and mob and isAlive(mob) then
            return mob, true
        end
    end

    -- Última checagem depois da navegação/streaming.
    local streamed = self:_findHumanBoss(name)
    if streamed then
        return streamed, true
    end

    -- Continua informando que o spawn está ativo.
    -- O próximo ciclo reaplica o Tween; não cai no Hop.
    return nil, true
end

function Module:_humanAllBossesAvailable()
    for _, name in ipairs(self.Config.HumanBosses) do
        if not self:_findHumanBoss(name) then
            return false, name
        end
    end
    return true
end

function Module:_humanAllBossesKilledByModule()
    for _, name in ipairs(self.Config.HumanBosses) do
        if self.State.HumanKilled[name] ~= true then
            return false, name
        end
    end
    return true
end

function Module:_runHuman()
    -- HUMAN V3 ATUAL:
    -- Wenlocktoad("1") e o remote capturado pelo Cobalt ANTES de matar
    -- Diamond + Jeremy + Orbitus. Chamamos UMA vez por sessao da quest.
    -- Nunca fazemos polling com "1" entre os bosses.

    if not self.State.HumanQuestStarted then
        self:_status(
            "Race V3 Human | Iniciando missao",
            "Primeiro indo ate Arowe/Wenlocktoad"
        )

        -- O remote de início só é chamado estando fisicamente perto do NPC.
        if not self:_goToWenlock("Iniciar quest") then
            return false
        end

        self:_status(
            "Race V3 Human | Iniciando missao",
            "Pegando quest | chamando Wenlocktoad(2)"
        )

        -- Wenlocktoad("2") pega/inicia a quest da Race V3.
        local result = self:_invokeWenlock("2", false)

        warn(
            "[Allan RaceV3 Human] Wenlocktoad(2) PEGAR QUEST => "
                .. tostring(result)
        )

        self.State.HumanQuestStarted = true
        self.State.HumanQuestStartedAt = os.clock()

        -- Ao entrar/iniciar em um servidor novo, dá tempo para mapa,
        -- Enemies e bosses streamarem antes de decidir por Hop.
        self.State.HumanServerGraceUntil =
            os.clock() + self.Config.HumanServerLoadGrace

        self:_status(
            "Race V3 Human | Aguardando servidor",
            "Carregando bosses antes de permitir Hop"
        )

        task.wait(1)
    end

    local allKilled = self:_humanAllBossesKilledByModule()

    if self.State.HumanSequenceStarted and allKilled then
        return self:ForceDeliverHumanV3(
            "Diamond + Jeremy + Orbitus abatidos"
        )
    end

    if not self.State.HumanSequenceStarted then
        self.State.HumanSequenceStarted = true
        self.State.HumanKilled = {}
        self.State.HumanAttempt =
            tonumber(self.State.HumanAttempt or 0) + 1

        self:_status(
            "Race V3 Human | Sequencia iniciada",
            "Tentativa "
                .. tostring(self.State.HumanAttempt)
                .. " | Diamond -> Jeremy -> Orbitus"
        )
    end

    for _, bossName in ipairs(self.Config.HumanBosses) do
        if not self:_shouldContinue() then
            return false
        end

        -- Boss já confirmado nesta mesma execução: segue para o próximo.
        if self.State.HumanKilled[bossName] == true then
            continue
        end

        local boss, spawnActive = self:_getHumanBoss(bossName)

        if not (boss and isAlive(boss)) then
            -- Se o spawn está Active, o boss existe neste servidor.
            -- Não importa se ainda não renderizou: continua no mesmo servidor.
            if spawnActive then
                self:_status(
                    "Race V3 Human | " .. tostring(bossName) .. " ativo",
                    "Ainda carregando/chegando no spawn | SEM HOP"
                )
                return false
            end

            self:_status(
                "Race V3 Human | Procurando " .. bossName,
                "Spawn nao esta ativo neste servidor"
            )

            local nowClock = os.clock()

            local retryNoHopUntil =
                tonumber(self.State.HumanRetryNoHopUntil or 0)

            local serverGraceUntil =
                tonumber(self.State.HumanServerGraceUntil or 0)

            local blockedUntil = math.max(
                retryNoHopUntil,
                serverGraceUntil
            )

            if nowClock < blockedUntil then
                local left = math.max(0, math.ceil(blockedUntil - nowClock))

                self:_status(
                    "Race V3 Human | Aguardando " .. bossName,
                    "Servidor carregando | Hop liberado em "
                        .. tostring(left)
                        .. "s"
                )

                return false
            end

            -- Hop SOMENTE quando CheckBossSpawn confirmou que o boss
            -- realmente não está ativo neste servidor.
            if self.Config.HumanHopIfSequenceNotStarted then
                self:_status(
                    "Race V3 Human | Boss indisponivel",
                    tostring(bossName) .. " sem spawn ativo | procurando servidor"
                )

                self:_hop(
                    "Race V3 Human | "
                        .. tostring(bossName)
                        .. " sem spawn ativo"
                )
            end

            return false
        end

        self:_status(
            "Race V3 Human | Matando " .. bossName,
            "Kill "
                .. tostring(
                    (bossName == "Diamond" and 1)
                    or (bossName == "Jeremy" and 2)
                    or 3
                )
                .. "/3"
        )

        local root = getRoot(boss)
        if root then
            local myRoot = getRoot(getCharacter())
            local distance = myRoot
                and (myRoot.Position - root.Position).Magnitude
                or 0

            -- Race V3: usa TP Reset/SSS em viagem longa e termina por Tween.
            if distance > 1200 and type(self.Adapter.SSS) == "function" then
                self:_status(
                    "Race V3 Human | " .. tostring(bossName),
                    "TP Reset para aproximar do boss"
                )

                pcall(
                    self.Adapter.SSS,
                    root.Position,
                    function()
                        return self:_shouldContinue()
                    end
                )

                task.wait(0.8)
            end

            self:_moveTo(root.CFrame * CFrame.new(0, 8, 8))
        end

        local trackedBoss = boss
        local started = now()
        local engaged = false
        local attackCalls = 0
        local timedOut = false
        local sawHealthDecrease = false

        local function ReadBossHealth()
            return readModelHealth(trackedBoss)
        end

        local previousHealth = ReadBossHealth()

        while self:_shouldContinue()
            and trackedBoss
            and trackedBoss.Parent
            and isAlive(trackedBoss)
        do
            engaged = true
            attackCalls += 1

            self:_attackMob(trackedBoss, function()
                return self:_shouldContinue()
                    and trackedBoss ~= nil
                    and trackedBoss.Parent ~= nil
                    and isAlive(trackedBoss)
            end)

            local currentHealth = ReadBossHealth()
            if previousHealth
                and currentHealth
                and currentHealth < previousHealth
            then
                sawHealthDecrease = true
            end

            if currentHealth then
                previousHealth = currentHealth
            end

            if now() - started > 120 then
                timedOut = true
                break
            end

            task.wait(0.1)
        end

        local killedByOurEngagement = false

        if engaged
            and attackCalls > 0
            and sawHealthDecrease
            and not timedOut
        then
            local finalHealth = ReadBossHealth()

            if finalHealth ~= nil then
                killedByOurEngagement = finalHealth <= 0
            else
                killedByOurEngagement =
                    trackedBoss.Parent == nil
                    and (now() - started) > 0.5
            end
        end

        if not killedByOurEngagement then
            self.State.HumanKilled[bossName] = nil

            self:_status(
                "Race V3 Human | Kill nao confirmada",
                bossName .. " | sem dano proprio confirmado ou morte invalida"
            )
            return false
        end

        self.State.HumanKilled[bossName] = true

        local doneCount = 0
        for _, required in ipairs(self.Config.HumanBosses) do
            if self.State.HumanKilled[required] == true then
                doneCount += 1
            end
        end

        self:_status(
            "Race V3 Human | Kill observada localmente",
            bossName .. " | " .. tostring(doneCount) .. "/3 | aguardando validacao do servidor"
        )

        -- IMPORTANTE: não chama Wenlock aqui.
        task.wait(0.8)
    end

    local finalAllKilled = self:_humanAllBossesKilledByModule()

    if finalAllKilled then
        return self:ForceDeliverHumanV3(
            "3 mortes observadas localmente | validando no servidor"
        )
    end

    return false
end

function Module:_targetAngelV3OrV4(player)
    if not player or player == LP then return false end
    if normalizeRace(getRaceValue(player)) ~= "Skypiea" then return false end
    if not player.Character or not isAlive(player.Character) then return false end
    if self:_isInSafeZone(player.Character) then return false end

    if self.Config.AngelRequireTargetV3OrV4 then
        return playerRaceTier(player) >= 3
    end

    return true
end

function Module:_runPlayerKillRace(raceMode)
    if self:TryDeliverV3() then
        return true
    end

    local candidates = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP and player.Character and isAlive(player.Character) then
            if raceMode == "Angel" then
                if self:_targetAngelV3OrV4(player) then
                    table.insert(candidates, player)
                end
            elseif raceMode == "Ghoul" then
                if not self:_isInSafeZone(player.Character) then
                    table.insert(candidates, player)
                end
            end
        end
    end

    if #candidates == 0 then
        self:_hop(
            raceMode == "Angel"
                and "Race V3 Angel | sem player Angel V3/V4 válido"
                or "Race V3 Ghoul | sem player válido"
        )
        return false
    end

    table.sort(candidates, function(a, b)
        local ar = getRoot(a.Character)
        local br = getRoot(b.Character)
        local my = getRoot(getCharacter())
        if not ar or not my then return false end
        if not br then return true end
        return (ar.Position - my.Position).Magnitude < (br.Position - my.Position).Magnitude
    end)

    for _, target in ipairs(candidates) do
        if not self:_shouldContinue() then return false end
        if self:TryDeliverV3() then return true end

        local targetChar = target.Character
        local root = getRoot(targetChar)

        self:_status(
            "Race V3 " .. raceMode .. " | PvP",
            "Alvo: " .. target.Name
                .. " | raça=" .. tostring(getRaceValue(target))
                .. " | tier=" .. tostring(playerRaceTier(target))
        )

        if root then
            self:_sss(root.Position)
        end

        self:_enablePvPIfNeeded()

        local started = now()
        local condition = function()
            return self:_shouldContinue()
                and target.Parent ~= nil
                and target.Character == targetChar
                and isAlive(targetChar)
                and not self:_isInSafeZone(targetChar)
                and now() - started < self.Config.PlayerKillTimeout
        end

        while condition() do
            self:_attackPlayer(target, condition)
            task.wait(0.1)
        end

        if self:_pollUntilDeliverable(4, target.Name .. " finalizado") then
            return true
        end
    end

    -- Ghoul pode precisar de mais de uma kill.
    -- Angel deve liberar assim que o alvo correto morrer.
    if raceMode == "Angel" then
        self:_hop("Race V3 Angel | alvo(s) usados e missão ainda não liberou")
    else
        self:_hop("Race V3 Ghoul | precisa de mais jogadores")
    end

    return false
end

function Module:_getChests()
    local result = {}

    local ok, tagged = pcall(function()
        return CollectionService:GetTagged("_ChestTagged")
    end)

    if ok and type(tagged) == "table" then
        for _, chest in ipairs(tagged) do
            if chest
                and chest.Parent
                and not chest:GetAttribute("IsDisabled")
                and (
                    not chest:GetAttribute("LastCollect")
                    or now() - chest:GetAttribute("LastCollect") > 120
                )
            then
                table.insert(result, chest)
            end
        end
    end

    return result
end

function Module:_runMink()
    if self:TryDeliverV3() then
        return true
    end

    local collected = 0

    while self:_shouldContinue()
        and collected < self.Config.MinkChestGoal
    do
        if self:TryDeliverV3() then return true end

        local chests = self:_getChests()

        if #chests == 0 then
            self:_status(
                "Race V3 Mink | Chests",
                tostring(collected) .. "/" .. tostring(self.Config.MinkChestGoal)
                    .. " | nenhum chest, hop"
            )
            self:_hop("Race V3 Mink | sem chests")
            return false
        end

        local myRoot = getRoot(getCharacter())
        table.sort(chests, function(a, b)
            if not myRoot then return false end
            return distance(a, myRoot) < distance(b, myRoot)
        end)

        local chest = chests[1]
        local cf = toCFrame(chest)

        if cf then
            self:_status(
                "Race V3 Mink | Coletando chest",
                tostring(collected + 1) .. "/" .. tostring(self.Config.MinkChestGoal)
            )

            self:_moveTo(cf)

            local reachedAt = nil
            local deadline = now() + 8

            while self:_shouldContinue()
                and chest
                and chest.Parent
                and now() < deadline
            do
                local charRoot = getRoot(getCharacter())
                if charRoot and distance(charRoot, chest) <= self.Config.ChestReachDistance then
                    reachedAt = reachedAt or now()

                    if now() - reachedAt >= self.Config.ChestStaySeconds then
                        pcall(function()
                            chest:SetAttribute("LastCollect", now())
                        end)
                        break
                    end
                else
                    reachedAt = nil
                    self:_moveTo(cf)
                end

                local hum = getHumanoid(getCharacter())
                if hum then
                    pcall(function()
                        hum:ChangeState(Enum.HumanoidStateType.Jumping)
                    end)
                end

                task.wait(0.1)
            end

            collected += 1

            if self:_pollUntilDeliverable(1.5, "Chest " .. tostring(collected)) then
                return true
            end
        else
            pcall(function()
                chest:SetAttribute("LastCollect", now())
            end)
        end
    end

    return self:_pollUntilDeliverable(15, "Chests concluídos")
end

function Module:_getBoat()
    local boats = Workspace:FindFirstChild("Boats")
    if not boats then return nil end

    for _, boat in ipairs(boats:GetChildren()) do
        local owner = boat:FindFirstChild("Owner")
        local seat = boat:FindFirstChild("VehicleSeat")

        if owner and owner.Value == LP and seat then
            return boat
        end
    end

    return nil
end

function Module:_boatValid(boat)
    return boat
        and boat.Parent
        and boat:FindFirstChild("VehicleSeat") ~= nil
end

function Module:_moveBoatTo(boat, targetPosition, condition)
    if not self:_boatValid(boat) then return false end

    if type(self.Adapter.MoveBoatTo) == "function" then
        local ok, result = pcall(self.Adapter.MoveBoatTo, boat, targetPosition, condition)
        if ok then return result ~= false end
    end

    local seat = boat.VehicleSeat
    local d = (seat.Position - targetPosition).Magnitude
    local speed = 350

    local tween = TweenService:Create(
        seat,
        TweenInfo.new(math.max(d / speed, 0.1), Enum.EasingStyle.Linear),
        {CFrame = CFrame.new(targetPosition)}
    )
    tween:Play()

    local started = now()

    while self:_shouldContinue()
        and self:_boatValid(boat)
        and now() - started < d / speed + 8
    do
        if condition and not condition() then
            tween:Cancel()
            return false
        end

        if (seat.Position - targetPosition).Magnitude <= 80 then
            return true
        end

        task.wait(0.15)
    end

    return self:_boatValid(boat)
        and (seat.Position - targetPosition).Magnitude <= 120
end

function Module:_ensureSharkBoat()
    local boat = self:_getBoat()
    if boat and boat.Name == self.Config.SharkBoat then
        self.State.SharkBoat = boat
        return boat
    end

    self:_status(
        "Race V3 Shark | Barco",
        "Comprando " .. self.Config.SharkBoat
    )

    self:_sss(self.Config.SharkSea2Dealer)
    self:_moveTo(CFrame.new(self.Config.SharkSea2Dealer))

    pcall(function()
        CommF:InvokeServer("BuyBoat", self.Config.SharkBoat)
    end)

    local deadline = now() + 10
    repeat
        task.wait(0.25)
        boat = self:_getBoat()
        if boat then break end
    until now() >= deadline

    if boat then
        self.State.SharkBoat = boat
        return boat
    end

    return nil
end

function Module:_sitInBoat(boat)
    if not self:_boatValid(boat) then return false end

    local char = getCharacter()
    local hum = getHumanoid(char)
    if not hum then return false end

    if hum.SeatPart == boat.VehicleSeat then
        return true
    end

    hum.Sit = false

    self:_moveTo(boat.VehicleSeat.CFrame + Vector3.new(0, 3, 0))

    local deadline = now() + 6
    while self:_shouldContinue()
        and self:_boatValid(boat)
        and now() < deadline
    do
        pcall(function()
            boat.VehicleSeat:Sit(hum)
        end)

        if hum.SeatPart == boat.VehicleSeat then
            return true
        end

        task.wait(0.2)
    end

    return hum.SeatPart == boat.VehicleSeat
end

function Module:_isSeaEventAlive(model)
    if not model or not model.Parent then return false end

    local health = model:FindFirstChild("Health")
    if health and health:IsA("ValueBase") then
        return tonumber(health.Value) ~= nil and health.Value > 0
    end

    return isAlive(model)
end

function Module:_findSeaEvent()
    local myRoot = getRoot(getCharacter())
    if not myRoot then return nil end

    local best, bestDist, bestType = nil, math.huge, nil

    local seaBeasts = Workspace:FindFirstChild("SeaBeasts")
    if seaBeasts then
        for _, event in ipairs(seaBeasts:GetChildren()) do
            if string.find(event.Name, "SeaBeast")
                and self:_isSeaEventAlive(event)
            then
                local root = getRoot(event)
                local d = root and (root.Position - myRoot.Position).Magnitude or math.huge
                if d <= self.Config.SharkSeaEventSearchRadius and d < bestDist then
                    best = event
                    bestDist = d
                    bestType = "SeaBeast"
                end
            end
        end
    end

    local enemies = Workspace:FindFirstChild("Enemies")
    if enemies then
        local shipNames = {
            PirateBrigade = true,
            PirateBasic = true,
            FishBoat = true,
            PirateGrandBrigade = true,
        }

        for _, event in ipairs(enemies:GetChildren()) do
            if shipNames[event.Name]
                and event:FindFirstChild("Engine")
                and self:_isSeaEventAlive(event)
            then
                local d = (event.Engine.Position - myRoot.Position).Magnitude
                if d <= self.Config.SharkSeaEventSearchRadius and d < bestDist then
                    best = event
                    bestDist = d
                    bestType = "Ship"
                end
            end
        end
    end

    return best, bestType
end

function Module:_defaultPressSkills(target)
    local char = getCharacter()
    local hum = getHumanoid(char)
    local bp = LP:FindFirstChild("Backpack")
    local root = getRoot(target)

    if not char or not hum or not bp or not root then return end

    -- Compatibilidade com hooks de silent aim já existentes no hub.
    local env = getgenv and getgenv() or _G
    env.SilentAimPos = true
    env.PosToHook = root.Position

    local preferredTips = {"Blox Fruit", "Melee", "Sword", "Gun"}
    local keys = {"Z", "X", "C", "V", "F"}

    for _, tooltip in ipairs(preferredTips) do
        if not self:_shouldContinue() or not self:_isSeaEventAlive(target) then break end

        local tool = nil

        for _, t in ipairs(char:GetChildren()) do
            if t:IsA("Tool") and t.ToolTip == tooltip then
                tool = t
                break
            end
        end

        if not tool then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") and t.ToolTip == tooltip then
                    tool = t
                    break
                end
            end
        end

        if tool and tool.Parent == bp then
            pcall(function()
                hum:EquipTool(tool)
            end)
            task.wait(0.1)
        end

        if tool then
            for _, key in ipairs(keys) do
                if not self:_isSeaEventAlive(target) then break end

                pcall(function()
                    VirtualInputManager:SendKeyEvent(true, key, false, game)
                    task.wait(0.05)
                    VirtualInputManager:SendKeyEvent(false, key, false, game)
                end)

                task.wait(self.Config.SeaSkillDelay)
            end
        end
    end
end

function Module:_attackSeaEvent(target, eventType)
    if not target then return false end

    local condition = function()
        return self:_shouldContinue()
            and target.Parent ~= nil
            and self:_isSeaEventAlive(target)
    end

    if type(self.Adapter.AttackSeaTarget) == "function" then
        local ok, result = pcall(
            self.Adapter.AttackSeaTarget,
            target,
            eventType,
            condition
        )
        if ok then return result ~= false end
    end

    -- Fallback focado: sai do barco, fica acima do evento e spamma skills.
    local hum = getHumanoid(getCharacter())
    if hum then hum.Sit = false end

    local started = now()

    while condition() and now() - started < 120 do
        local root = getRoot(target)

        if root then
            self:_moveTo(
                root.CFrame * CFrame.new(0, self.Config.SeaAttackHeight, -40),
                condition
            )
        end

        self:_defaultPressSkills(target)
        task.wait(0.1)
    end

    return not self:_isSeaEventAlive(target)
end

function Module:_runShark()
    if self:TryDeliverV3() then
        return true
    end

    local started = now()

    while self:_shouldContinue()
        and now() - started < self.Config.SharkTimeout
    do
        local state = self:WenlockState()

        if state == 2 then
            return self:TryDeliverV3()
        end

        if state ~= 1 and self:IsV3() then
            return true
        end

        local boat = self:_ensureSharkBoat()

        if not boat then
            self:_status(
                "Race V3 Shark | Barco",
                "Não conseguiu comprar/spawnar barco; tentando novamente"
            )
            task.wait(2)
            continue
        end

        self:_status(
            "Race V3 Shark | Indo ao mar",
            "Barco: " .. tostring(boat.Name)
        )

        self:_sitInBoat(boat)

        -- Snow usa esta região do Sea 2 para gerar/farmar eventos.
        self:_moveBoatTo(
            boat,
            self.Config.SharkSea2FarmPosition,
            function()
                return self:_shouldContinue()
                    and self:WenlockState() ~= 2
            end
        )

        -- Procura eventos continuamente; ao matar qualquer um,
        -- consulta Wenlock antes de fazer qualquer outra coisa.
        local scanDeadline = now() + 90

        while self:_shouldContinue() and now() < scanDeadline do
            if self:TryDeliverV3() then
                return true
            end

            local event, eventType = self:_findSeaEvent()

            if event then
                self:_status(
                    "Race V3 Shark | Sea Event",
                    "Atacando " .. tostring(eventType) .. ": " .. tostring(event.Name)
                )

                self:_attackSeaEvent(event, eventType)
                self.State.SharkKilledEvent = true

                if self:_pollUntilDeliverable(8, "Sea Event concluído") then
                    return true
                end

                -- Se ainda retornou 1, volta ao barco e continua procurando.
                boat = self:_getBoat()
                if boat then
                    self:_sitInBoat(boat)
                    self:_moveBoatTo(boat, self.Config.SharkSea2FarmPosition)
                end
            else
                self:_status(
                    "Race V3 Shark | Sea Event",
                    "Aguardando Sea Beast/Ship aparecer"
                )

                -- Mantém o barco na região de spawn.
                boat = self:_getBoat()
                if boat and self:_boatValid(boat) then
                    if (boat.VehicleSeat.Position - self.Config.SharkSea2FarmPosition).Magnitude > 300 then
                        self:_sitInBoat(boat)
                        self:_moveBoatTo(boat, self.Config.SharkSea2FarmPosition)
                    end
                end
            end

            task.wait(1)
        end
    end

    if self.State.SharkKilledEvent then
        -- Já matou evento: não hopa antes de dar uma última janela ao Wenlock.
        return self:_pollUntilDeliverable(20, "Shark | evento já morto")
    end

    self:_hop("Race V3 Shark | nenhum Sea Event apareceu")
    return false
end

function Module:_runCyborg()
    if self:TryDeliverV3() then
        return true
    end

    self:_status(
        "Race V3 Cyborg",
        "Preparando entrega / fruta de sacrifício"
    )

    if type(self.Adapter.LoadSacrificeFruit) == "function" then
        pcall(self.Adapter.LoadSacrificeFruit)
        task.wait(0.5)
    end

    -- O Snow chama Wenlocktoad 3 diretamente nesta fase.
    pcall(function()
        CommF:InvokeServer("Wenlocktoad", "3")
    end)

    task.wait(1)

    if self:IsV3() then
        return true
    end

    return self:_pollUntilDeliverable(8, "Cyborg")
end

function Module:ResetSession()
    self.State.HumanSequenceStarted = false
    self.State.HumanQuestStarted = false
    self.State.HumanQuestStartedAt = nil
    self.State.HumanKilled = {}
    self.State.HumanLastDeliveryAt = 0
    self.State.HumanDeliveryRejected = false
    self.State.HumanRetryNoHopUntil = 0
    self.State.HumanAttempt = 0
    self.State.HumanServerGraceUntil = 0
    self.State.SharkKilledEvent = false
    self.State.SharkBoat = nil
    self.State.LastWenlockState = nil
    self.State.LastStatus = nil
end

function Module:Stop()
    self.State.StopRequested = true
end

function Module:Run()
    if self.State.Running then
        return false, "ALREADY_RUNNING"
    end

    self:AutoBindFromAllanHub()

    self.State.Running = true
    self.State.StopRequested = false

    local ok, result = xpcall(function()
        if self:IsV3() then
            self:_status("Race V3", "Já desbloqueada")
            return true
        end

        local race = normalizeRace(getRaceValue(LP))
        self.State.CurrentRace = race

        self:_status("Race V3 | Iniciando", "Raça: " .. tostring(race))

        -- Human usa fluxo proprio:
        -- Wenlocktoad("1") UMA vez antes dos bosses -> 3 bosses -> finalizacao.
        -- Nao passa pela maquina generica que fica consultando Wenlocktoad("1").
        if race == "Human" then
            return self:_runHuman()
        end

        local function RunRaceHandler()
            if race == "Skypiea" then
                return self:_runPlayerKillRace("Angel")
            elseif race == "Ghoul" then
                return self:_runPlayerKillRace("Ghoul")
            elseif race == "Mink" then
                return self:_runMink()
            elseif race == "Fishman" then
                return self:_runShark()
            elseif race == "Cyborg" then
                return self:_runCyborg()
            end

            self:_status(
                "Race V3",
                "Raça sem handler: " .. tostring(race)
            )
            return false
        end

        -- O Wenlock atual pode responder nil. Nao tratamos nil como erro fatal.
        local state = self:WenlockState()

        if state == -2 then
            self:_status("Race V3", "Wenlocktoad confirmou V3")
            return true
        end

        -- Se retornou 0, inicia a quest normalmente.
        if state == 0 then
            self:_status("Race V3 | Wenlocktoad", "Iniciando missão")
            pcall(function()
                self:_invokeWenlock("2", false)
            end)
            task.wait(0.8)
            state = self:WenlockState()
        end

        -- Se o retorno veio nil, faz tentativas curtas.
        if state == nil then
            self:_status(
                "Race V3 | Wenlocktoad",
                "Retorno nil | tentando sincronizar missão"
            )

            for attempt = 1, self.Config.WenlockNilRetries do
                if not self:_shouldContinue() then
                    return false
                end

                if self:IsV3() then
                    return true
                end

                -- Wenlocktoad(2) funciona como tentativa segura de iniciar/garantir
                -- que a quest esteja ativa; se já estiver ativa o servidor ignora.
                if attempt == 1 then
                    pcall(function()
                        self:_invokeWenlock("2", false)
                    end)
                end

                task.wait(self.Config.WenlockNilRetryDelay)
                state = self:WenlockState()

                self:_status(
                    "Race V3 | Wenlocktoad",
                    "Sincronizando | tentativa "
                        .. tostring(attempt)
                        .. "/"
                        .. tostring(self.Config.WenlockNilRetries)
                        .. " | estado="
                        .. tostring(state)
                )

                if state ~= nil then
                    break
                end
            end
        end

        if state == -2 then
            return true
        end

        if state == 2 then
            if self:TryDeliverV3() then
                return true
            end

            -- Se a entrega normal nao confirmou, Human possui entrega forcada.
            if race == "Human" then
                return self:ForceDeliverHumanV3("Wenlocktoad retornou 2")
            end
        end

        if state == 1 then
            return RunRaceHandler()
        end

        if state == 0 then
            -- O servidor ainda nao mudou de 0 depois do passo 2.
            -- Nao trava o scheduler; no proximo ciclo tenta novamente.
            self:_status(
                "Race V3 | Wenlocktoad",
                "Missão ainda iniciando | aguardando próximo ciclo"
            )
            return false
        end

        -- FIX PRINCIPAL:
        -- nil/retorno desconhecido nao interrompe mais a Race V3.
        -- O script executa o objetivo especifico da raça e continua consultando
        -- Wenlocktoad dentro do proprio handler.
        self:_status(
            "Race V3 | Wenlocktoad",
            "Estado " .. tostring(state)
                .. " | continuando pelo objetivo da raça "
                .. tostring(race)
        )

        -- IMPORTANTE:
        -- estado nil NÃO significa missão concluída.
        -- Nunca chama Wenlocktoad(3) preventivamente.
        -- Apenas continua pelo objetivo da raça.
        if race == "Human" and state == nil then
            self:_status(
                "Race V3 Human | Wenlock nil",
                "Objetivo ainda não confirmado | procurando/matando bosses"
            )
        end

        return RunRaceHandler()
    end, debug.traceback)

    self.State.Running = false

    if not ok then
        warn("[Allan RaceV3 Module] " .. tostring(result))
        self:_status("Race V3 | Erro", tostring(result))
        return false, result
    end

    return result
end

function Module:Step()
    -- Alias para integração com schedulers que chamam uma função por tarefa.
    return self:Run()
end

-- Instância única retornada pelo loadstring.
local instance = setmetatable({}, Module)
instance.Config = Module.Config
instance.State = Module.State
instance.Adapter = Module.Adapter
instance.Version = Module.Version

return instance
