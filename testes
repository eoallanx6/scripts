local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local CommF = Remotes:WaitForChild("CommF_")
local CommE = Remotes:FindFirstChild("CommE")

Module.Version = "1.0.0"

Module.Config = {
    -- ATUALIZADO pelo Allan: os tres bosses atuais da Human V3.
    HumanBosses = {"Diamond", "Jeremy", "Orbitus"},

    HumanHopIfSequenceNotStarted = true,
    HumanWaitAfterBoss = 6,
    HumanFinalWenlockWait = 30,

    AngelRequireTargetV3OrV4 = true,
    PlayerKillTimeout = 90,
    EnablePvPWait = 6,

    MinkChestGoal = 30,
    ChestReachDistance = 10,
    ChestStaySeconds = 1.5,

    SharkBoat = "PirateSloop",
    SharkSea2Dealer = Vector3.new(-5387.28369140625, 8.969104766845703, -716.620361328125),
    SharkSea2FarmPosition = Vector3.new(-8243.55078125, 0.1520378142595291, 2916.398193359375),
    SharkSeaEventSearchRadius = 3200,
    SharkTimeout = 600,

    DefaultTweenSpeed = 300,
    SeaAttackHeight = 90,
